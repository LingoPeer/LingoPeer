# Backend API (HTTPS in production). No trailing slash.
# Local:
VITE_API_BASE_URL=http://localhost:5000
# Deployed backend (Railway example):
# VITE_API_BASE_URL=https://lingopeer-production.up.railway.app

# Optional: Google Sign-In client ID (same project as backend OAuth config).
# VITE_GOOGLE_CLIENT_ID=

# Optional request timeout for apiFetch/upload (milliseconds)
# VITE_API_TIMEOUT_MS=12000
