          "title": "Present Perfect Tense",
          "subtitle": "Mastering life experiences and actions with present relevance.",
          "explanation": "The present perfect is used to indicate a link between the present and the past. The time of the action is before now but not specified, and we are often more interested in the result than in the action itself.",
          "formula": {
            "parts": ["Subject", "Have / Has", "Past Participle"]
          },
          "examples": [
            {
              "category": "TRAVEL",
              "sentence": "I have visited Paris three times.",
              "highlighted": "have visited",
              "description": "Experience in life without a specific date."
            },
            {
              "category": "ACHIEVEMENT",
              "sentence": "She has finished her degree.",
              "highlighted": "has finished",
              "description": "An action completed in the past with a present result."
            },
            {
              "category": "ONGOING",
              "sentence": "We have lived here since 2010.",
              "highlighted": "have lived",
              "description": "Started in the past and continues to the present."
            }
          ],
          "timeMarkers": [
            {
              "id": 1,
              "term": "Already",
              "definition": "Something happened sooner than expected."
            },
            {
              "id": 2,
              "term": "Yet",
              "definition": "Expectation that something will happen."
            },
            {
              "id": 3,
              "term": "Ever / Never",
